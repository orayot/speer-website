{
  "name": "speer-website",
  "description": "Static pages for Speer blog and landing",
  "version": "1.0.0",
  "author": "Shivek Khurana",
  "dependencies": {
    "gatsby": "^1.9.247",
    "gatsby-link": "^1.6.40",
    "gatsby-plugin-react-helmet": "^2.0.10",
    "gatsby-plugin-resolve-src": "^1.1.3",
    "gatsby-source-filesystem": "^1.5.38",
    "gatsby-transformer-remark": "^1.7.42",
    "react-helmet": "^5.2.0"
  },
  "scripts": {
    "build": "npm run format; gatsby build",
    "dev": "gatsby develop",
    "format": "prettier --write 'src/**/*.js'",
    "deploy:dev": "cd public; ./../node_modules/.bin/surge; cd ../",
    "deploy:s3": "aws s3 sync public/ s3://speer.app --region=ap-south-1",
    "deploy:prod": "rsync -avzhe ssh --progress ./public/* root@94.237.66.178:/root/speer.app",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "prettier": "^1.12.0",
    "surge": "^0.20.1"
  }
